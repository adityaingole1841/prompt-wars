# Emergency Helper India - Environment Configuration Example
# Copy this file to .env to configure your local setup.
# IMPORTANT: NEVER commit your real API keys or sensitive credentials!

# Port for the backend emergency safety API server
PORT=3001

# Optional: Google Gemini API key for advanced AI emergency situation analysis.
# If omitted or left blank, the app automatically runs its built-in,
# safety-first, deterministic emergency response engine so the prototype works immediately!
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
